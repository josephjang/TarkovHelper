<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Match the referenced desktop projects (TarkovHelper uses WPF, TarkovDBEditor uses WPF + WinForms) -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TarkovHelper\TarkovHelper.csproj" />
    <ProjectReference Include="..\TarkovDBEditor\TarkovDBEditor.csproj" />
    <!-- The diff report is the artefact a regeneration is reviewed against, so its comparison
         core is unit-tested here rather than trusted. Referencing the console project is
         deliberate: the tool has no separate library assembly to keep in step. -->
    <ProjectReference Include="..\tools\DataDiff\DataDiff.csproj" />
  </ItemGroup>

  <!-- Seed database under test. Nothing here copies or includes it: the app project already
       copies its own bundled seed into this assembly's output as Assets\tarkov_data.db
       (linked there from data/v$(TarkovDataFormatVersion)), and the fixture builders read that
       very file in place through TestSeed.DatabasePath, so they describe exactly the database
       the app under test runs and no second copy can go stale against it.
       Restating a source path here is what went wrong before: it named
       TarkovHelper\Assets\tarkov_data.db, the pre-channel mirror, which stops being
       republished the moment the live data format leaves 1, and the fixtures would then be
       derived from frozen format-1 data while driving an app shipping the newer format.
       That reason still stands, so the guard below fails the build loudly if the app ever
       stops putting the seed where TestSeed reads it. -->
  <Target Name="RequireSeedDatabaseFromAppOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Error Condition="!Exists('$(OutDir)Assets\tarkov_data.db')"
           Text="The app project no longer copies Assets\tarkov_data.db into the test output, so the fixtures have no seed to read. Point TestSeed at wherever the app now bundles its seed." />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
