<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- App version. Still 4.3.1 (inherited); the first fork release retargets this
         to CalVer YYYY.M.N via /release. AssemblyVersion/FileVersion are intentionally
         omitted so the SDK derives both from Version — one knob the release can't leave
         half-bumped, and the value UpdateService reads at runtime. -->
    <Version>2026.7.0</Version>
    <ApplicationIcon>1764579946.ico</ApplicationIcon>

    <!-- App identity (fork of Zeliper/Tarkov-Item-Helper, maintained at josephjang/TarkovHelper) -->
    <Product>Tarkov Helper</Product>
    <Authors>Zeliper, Jeongho Jang</Authors>
    <Copyright>Copyright (c) 2025 Zeliper, (c) 2026 Jeongho Jang</Copyright>
    <RepositoryUrl>https://github.com/josephjang/TarkovHelper</RepositoryUrl>

    <!-- Data format this build reads: the contract (schema + value semantics) of
         tarkov_data.db, bumped only by a publish that cannot stay additive. It is the
         single source for BOTH the seed database copied into the output below AND the
         update endpoint DatabaseUpdateService polls (via AssemblyMetadata), so the
         bundled data and the polled channel can never disagree. Bumping it means
         creating data/v<N>/ in the same PR. See feature-versioned-data-channel.spec.md. -->
    <TarkovDataFormat>1</TarkovDataFormat>

    <!-- AutoUpdater.NET 다국어 리소스 제한 (en, ko, ja만 유지) -->
    <SatelliteResourceLanguages>en;ko;ja-jp</SatelliteResourceLanguages>

    <!-- Run as Administrator -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="1764579946.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surfaces TarkovDataFormat to runtime code (DatabaseUpdateService reads it off
         the assembly to build its endpoint URLs). -->
    <AssemblyMetadata Include="TarkovDataFormat" Value="$(TarkovDataFormat)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded UI fonts, one entry per file (explicit so FontAssetsTests'
         csproj-vs-directory cross-check is meaningful) -->
    <Resource Include="Fonts\Bender-Regular.otf" />
    <Resource Include="Fonts\Bender-Bold.otf" />
    <Resource Include="Fonts\Play-Regular.ttf" />
    <Resource Include="Fonts\Play-Bold.ttf" />
    <Resource Include="Fonts\NotoSansCJKkr-Regular.otf" />
    <Resource Include="Fonts\NotoSansCJKkr-Bold.otf" />
    <!-- Font license texts must travel through publish into the release zip -->
    <None Update="Fonts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Maps\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Seed data, sourced from this build's data-format endpoint rather than from
         Assets\, so the bundled database is by construction the one the build's own
         channel serves. The Assets\ copies stay in the repo as the pre-channel endpoint
         that fielded builds poll (they hardcode those URLs and cannot be repointed);
         they are removed from the default None glob so exactly one item copies to
         Assets\ in the output. Link keeps the output layout unchanged: runtime paths,
         packaging, and e2e expectations all still find Assets\tarkov_data.db.
         The version stamp must ship: without it a fresh install re-downloads the full
         DB on its first check. -->
    <None Remove="Assets\tarkov_data.db" />
    <None Remove="Assets\db_version.txt" />
    <None Include="..\data\v$(TarkovDataFormat)\tarkov_data.db" Link="Assets\tarkov_data.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\data\v$(TarkovDataFormat)\db_version.txt" Link="Assets\db_version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\DB\Icons\*.webp" />
    <None Update="Assets\DB\Icons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\DB\Icons\Markers\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\DB\Maps\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\DB\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TarkovHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="Westermo.GraphX.Controls" Version="3.0.1" />
  </ItemGroup>

</Project>
